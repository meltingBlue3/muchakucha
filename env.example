# ===========================================
# 应用配置示例
# 复制此文件为 .env 并填写实际的配置值
# ===========================================

# 应用配置
APP_NAME=Family Calendar API
DEBUG=False

# 数据库配置
DB_NAME=family_calendar
DB_USER=family_user
DB_PASSWORD=your_secure_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_PORT=3306

# 数据库连接 URL（本地开发）
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://family_user:your_secure_password_here@localhost:3306/family_calendar

# Docker Compose 中会自动使用以下格式（无需手动配置）:
# DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@db:3306/${DB_NAME}

# 安全配置
# 生成 SECRET_KEY 的方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 后端服务端口
BACKEND_PORT=8000

