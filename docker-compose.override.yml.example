# Docker Compose Override 示例
# 复制此文件为 docker-compose.override.yml 以自定义本地开发配置
# docker-compose.override.yml 会自动与 docker-compose.yml 合并

version: '3.8'

services:
  # 后端服务自定义配置
  backend:
    # 自定义端口映射
    # ports:
    #   - "8001:8000"  # 如果 8000 端口被占用，可以改用其他端口
    
    # 自定义环境变量（覆盖 .env 文件）
    # environment:
    #   DEBUG: "True"
    #   LOG_LEVEL: "DEBUG"
    
    # 自定义启动命令
    # command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --log-level debug
    
    # 挂载额外的卷
    # volumes:
    #   - ./logs:/app/logs  # 日志目录
    #   - ./uploads:/app/uploads  # 上传文件目录

  # 数据库服务自定义配置
  db:
    # 自定义端口映射
    # ports:
    #   - "3307:3306"  # 如果 3306 端口被占用
    
    # 自定义配置
    # command: --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci

  # 添加其他开发工具服务
  # adminer:
  #   image: adminer
  #   restart: always
  #   ports:
  #     - "8080:8080"
  #   networks:
  #     - app_network
  #   depends_on:
  #     - db

  # Redis 缓存（如果需要）
  # redis:
  #   image: redis:7-alpine
  #   container_name: muchakucha_redis
  #   restart: unless-stopped
  #   ports:
  #     - "6379:6379"
  #   networks:
  #     - app_network
  #   volumes:
  #     - redis_data:/data

# volumes:
#   redis_data:

